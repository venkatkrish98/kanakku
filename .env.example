# Kanakku Environment Variables

# Database (PostgreSQL 16)
DATABASE_URL=postgres://kanakku_user:kanakku_dev_password@localhost:5433/kanakku_db

# MCP Server
MCP_SERVER_PORT=3001
MCP_BEARER_TOKEN=demo_tenant_secret_token_123

# Amazon Bedrock (Optional for local unit tests / mock mode)
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Application Logging
LOG_LEVEL=info
