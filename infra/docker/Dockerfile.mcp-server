# syntax=docker/dockerfile:1
# ==============================================================================
# Kanakku MCP Server - Production Container (AWS App Runner Compatible)
# Streamable HTTP MCP Endpoint on Port 3001
# ==============================================================================

# --- Stage 1: Build & Prune ---
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm and required build utilities
RUN corepack enable && corepack prepare pnpm@12.6.0 --activate
RUN apk add --no-cache libc6-compat python3 make g++

# Copy root workspace configurations
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./

# Copy package manifests for isolated dependency resolution
COPY packages/core/package.json packages/core/tsconfig.json ./packages/core/
COPY packages/db/package.json packages/db/tsconfig.json ./packages/db/
COPY packages/mcp-server/package.json packages/mcp-server/tsconfig.json ./packages/mcp-server/

# Install all workspace dependencies
RUN pnpm install --frozen-lockfile

# Copy source trees
COPY packages/core/src ./packages/core/src
COPY packages/db/src ./packages/db/src
COPY packages/db/drizzle.config.ts ./packages/db/
COPY packages/mcp-server/src ./packages/mcp-server/src

# Build TypeScript packages in topological order
RUN pnpm --filter @kanakku/core build
RUN pnpm --filter @kanakku/db build
RUN pnpm --filter @kanakku/mcp-server build

# --- Stage 2: Production Runtime ---
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

# Create non-privileged service user
RUN addgroup --system --gid 1001 kanakku && \
    adduser --system --uid 1001 kanakku

# Copy node_modules and built code from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

COPY --from=builder /app/packages/core/package.json ./packages/core/package.json
COPY --from=builder /app/packages/core/dist ./packages/core/dist

COPY --from=builder /app/packages/db/package.json ./packages/db/package.json
COPY --from=builder /app/packages/db/dist ./packages/db/dist

COPY --from=builder /app/packages/mcp-server/package.json ./packages/mcp-server/package.json
COPY --from=builder /app/packages/mcp-server/dist ./packages/mcp-server/dist

USER kanakku

EXPOSE 3001

# App Runner / Container Health Check
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:3001/health || exit 1

CMD ["node", "packages/mcp-server/dist/index.js"]
