{
  "name": "@kanakku/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "outbox:sweep": "tsx src/scripts/sweep-audit-outbox.ts",
    "outbox:worker": "tsx src/scripts/sweep-audit-outbox.ts --continuous"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1141.0",
    "@kanakku/core": "workspace:*",
    "@kanakku/db": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
