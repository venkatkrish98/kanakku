{
  "name": "@kanakku/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"const fs = require('fs'); fs.cpSync('src/migrations', 'dist/migrations', {recursive: true, force: true});\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:bootstrap-app-role": "tsx src/scripts/bootstrap-app-role.ts",
    "db:rotate-key": "tsx src/scripts/rotate-key.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@kanakku/core": "workspace:*",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
